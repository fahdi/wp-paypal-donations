{
  "name": "wp-paypal-donations/plugin",
  "description": "PayPal donations plugin for WordPress with automated testing",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "WP PayPal Donations",
      "email": "support@example.com"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "wp-coding-standards/wpcs": "^2.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7",
    "squizlabs/php_codesniffer": "^3.6",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "WPPayPalDonations\\": "src/",
      "WPPayPalDonations\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite 'Unit Tests'",
    "test:integration": "phpunit --testsuite 'Integration Tests'",
    "test:coverage": "phpunit --coverage-html tests/coverage",
    "lint": "phpcs --standard=WordPress *.php admin/ templates/ blocks/",
    "lint:fix": "phpcbf --standard=WordPress *.php admin/ templates/ blocks/"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}