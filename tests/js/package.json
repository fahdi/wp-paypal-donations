{
  "name": "wp-paypal-donations-js-tests",
  "version": "1.0.0",
  "description": "JavaScript tests for WP PayPal Donations plugin",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": ["wordpress", "paypal", "donations", "testing", "jest"],
  "author": "WP PayPal Donations",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "babel-jest": "^29.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/setup-tests.js"],
    "collectCoverageFrom": [
      "../../assets/js/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": ["text", "lcov", "html"]
  },
  "babel": {
    "presets": ["@babel/preset-env"]
  }
}